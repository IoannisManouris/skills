{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-lighting/lighting-plan.schema.json",
  "title": "Roblox Lighting Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "mode",
    "intent",
    "confidence",
    "lighting",
    "local_lights",
    "quality_tiers",
    "validation",
    "unresolved_ambiguities"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$"},
    "generated_at": {"type": ["string", "null"]},
    "mode": {
      "enum": ["FROM_SCRATCH", "MATCH_SCREENSHOT", "LINK_ASSISTED_MATCH", "IMPROVE_OR_DEBUG", "AUDIT_OR_OPTIMIZE"]
    },
    "intent": {
      "type": "object",
      "required": ["thesis", "genre", "mood", "target_state"],
      "properties": {
        "thesis": {"type": "string", "minLength": 10},
        "genre": {"type": "string"},
        "mood": {"type": "array", "items": {"type": "string"}},
        "target_state": {"type": "string"},
        "camera_use": {"type": ["string", "null"]},
        "minimum_platform": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "lighting": {
      "type": "object",
      "required": ["properties", "sky", "atmosphere", "legacy_fog", "clouds", "post_effects"],
      "properties": {
        "properties": {
          "type": "object",
          "properties": {
            "Ambient": {"$ref": "#/$defs/color"},
            "Brightness": {"type": "number", "minimum": 0},
            "ClockTime": {"type": "number", "minimum": 0, "maximum": 24},
            "ColorShift_Bottom": {"$ref": "#/$defs/color"},
            "ColorShift_Top": {"$ref": "#/$defs/color"},
            "EnvironmentDiffuseScale": {"type": "number", "minimum": 0, "maximum": 1},
            "EnvironmentSpecularScale": {"type": "number", "minimum": 0, "maximum": 1},
            "ExposureCompensation": {"type": "number", "minimum": -5, "maximum": 5},
            "FogColor": {"$ref": "#/$defs/color"},
            "FogEnd": {"type": "number"},
            "FogStart": {"type": "number"},
            "GeographicLatitude": {"type": "number", "minimum": -90, "maximum": 90},
            "GlobalShadows": {"type": "boolean"},
            "LightingStyle": {"enum": ["Realistic", "Soft"]},
            "OutdoorAmbient": {"$ref": "#/$defs/color"},
            "PrioritizeLightingQuality": {"type": "boolean"},
            "ShadowSoftness": {"type": "number", "minimum": 0, "maximum": 1},
            "TimeOfDay": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"}
          },
          "additionalProperties": false
        },
        "manual_properties": {
          "type": "object",
          "description": "Properties that may be Not Scriptable or security restricted, such as ExtendLightRangeTo120.",
          "additionalProperties": true
        },
        "sky": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["enabled", "name", "properties"],
              "properties": {
                "enabled": {"type": "boolean"},
                "name": {"type": "string"},
                "properties": {"type": "object", "additionalProperties": true}
              },
              "additionalProperties": true
            }
          ]
        },
        "atmosphere": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["enabled", "name", "properties"],
              "properties": {
                "enabled": {"type": "boolean"},
                "name": {"type": "string"},
                "properties": {
                  "type": "object",
                  "properties": {
                    "Color": {"$ref": "#/$defs/color"},
                    "Decay": {"$ref": "#/$defs/color"},
                    "Density": {"type": "number", "minimum": 0, "maximum": 1},
                    "Glare": {"type": "number", "minimum": 0},
                    "Haze": {"type": "number", "minimum": 0},
                    "Offset": {"type": "number", "minimum": -1, "maximum": 1}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "legacy_fog": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "FogColor": {"$ref": "#/$defs/color"},
            "FogStart": {"type": "number"},
            "FogEnd": {"type": "number"}
          },
          "additionalProperties": false
        },
        "clouds": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["enabled", "name", "properties"],
              "properties": {
                "enabled": {"type": "boolean"},
                "name": {"type": "string"},
                "properties": {
                  "type": "object",
                  "properties": {
                    "Color": {"$ref": "#/$defs/color"},
                    "Cover": {"type": "number", "minimum": 0, "maximum": 1},
                    "Density": {"type": "number", "minimum": 0, "maximum": 1},
                    "Enabled": {"type": "boolean"}
                  },
                  "additionalProperties": false
                },
                "global_wind": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "number"}
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "post_effects": {
          "type": "array",
          "items": {"$ref": "#/$defs/postEffect"}
        }
      },
      "additionalProperties": false
    },
    "local_lights": {
      "type": "array",
      "items": {"$ref": "#/$defs/localLight"}
    },
    "material_geometry_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "action", "reason", "priority"],
        "properties": {
          "target": {"type": "string"},
          "action": {"type": "string"},
          "reason": {"type": "string"},
          "priority": {"enum": ["required", "recommended", "optional"]}
        },
        "additionalProperties": true
      }
    },
    "runtime_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "activation", "transition_seconds"],
        "properties": {
          "name": {"type": "string"},
          "activation": {"type": "string"},
          "transition_seconds": {"type": "number", "minimum": 0},
          "client_local": {"type": "boolean"},
          "overrides": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": true
      }
    },
    "quality_tiers": {
      "type": "object",
      "required": ["low", "medium", "high"],
      "properties": {
        "low": {"$ref": "#/$defs/qualityTier"},
        "medium": {"$ref": "#/$defs/qualityTier"},
        "high": {"$ref": "#/$defs/qualityTier"}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["views", "gameplay_gates", "performance_gates", "stopping_criteria"],
      "properties": {
        "views": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "image_metrics": {"type": "array", "items": {"type": "string"}},
        "gameplay_gates": {"type": "array", "items": {"type": "string"}},
        "performance_gates": {"type": "array", "items": {"type": "string"}},
        "stopping_criteria": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "unresolved_ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "impact", "best_next_evidence"],
        "properties": {
          "question": {"type": "string"},
          "impact": {"type": "string"},
          "best_next_evidence": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "postEffect": {
      "type": "object",
      "required": ["class", "name", "parent", "enabled", "properties"],
      "properties": {
        "class": {
          "enum": ["BloomEffect", "BlurEffect", "ColorCorrectionEffect", "ColorGradingEffect", "DepthOfFieldEffect", "SunRaysEffect"]
        },
        "name": {"type": "string"},
        "parent": {"enum": ["Lighting", "Camera"]},
        "enabled": {"type": "boolean"},
        "properties": {"type": "object", "additionalProperties": true},
        "quality_tiers": {
          "type": "array",
          "items": {"enum": ["low", "medium", "high"]},
          "uniqueItems": true
        },
        "rationale": {"type": "string"}
      },
      "additionalProperties": true
    },
    "localLight": {
      "type": "object",
      "required": ["id", "class", "name", "target_path", "properties", "quality_tiers", "rationale"],
      "properties": {
        "id": {"type": "string"},
        "class": {"enum": ["PointLight", "SpotLight", "SurfaceLight"]},
        "name": {"type": "string"},
        "target_path": {"type": "string", "pattern": "^/Workspace(?:/.*)?$"},
        "properties": {
          "type": "object",
          "properties": {
            "Enabled": {"type": "boolean"},
            "Color": {"$ref": "#/$defs/color"},
            "Brightness": {"type": "number", "minimum": 0},
            "Shadows": {"type": "boolean"},
            "Range": {"type": "number", "minimum": 0},
            "Angle": {"type": "number", "minimum": 0, "maximum": 180},
            "Face": {"enum": ["Front", "Back", "Left", "Right", "Top", "Bottom"]}
          },
          "additionalProperties": false
        },
        "quality_tiers": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["low", "medium", "high"]},
          "uniqueItems": true
        },
        "rationale": {"type": "string"},
        "activation_group": {"type": ["string", "null"]},
        "source_visible": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "qualityTier": {
      "type": "object",
      "required": ["goal", "enabled_light_ids", "enabled_post_effects", "notes"],
      "properties": {
        "goal": {"type": "string"},
        "enabled_light_ids": {"type": "array", "items": {"type": "string"}},
        "enabled_post_effects": {"type": "array", "items": {"type": "string"}},
        "property_overrides": {"type": "object", "additionalProperties": true},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
